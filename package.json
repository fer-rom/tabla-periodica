{
  "name": "tabla-periodica",
  "version": "1.0.0",
  "private": true,
  "description": "Tabla periódica interactiva, bilingüe (ES/EN) y offline.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/check-budget.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:fetch": "tsx scripts/fetch-sources.ts",
    "data:build": "tsx scripts/build-data.ts",
    "og": "tsx scripts/og-images.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
